# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY: Требуется для вызовов Gemini AI API.
# AI Studio automatically injects this at runtime from user secrets.
# AI Studio автоматически внедряет это во время выполнения из секретов пользователя.
# Users configure this via the Secrets panel in the AI Studio UI.
# Пользователи настраивают это через панель Secrets в интерфейсе AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# APP_URL: URL, по которому размещен этот апплет.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# AI Studio автоматически внедряет это во время выполнения с URL-адресом Cloud Run.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Используется для самоссылающихся ссылок, OAuth-обратных вызовов и конечных точек API.
APP_URL="MY_APP_URL"

